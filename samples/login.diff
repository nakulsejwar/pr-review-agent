+def login(username: str, password: str, remember=[]):
+    row = DB.execute(
+        f"SELECT id, pw_hash FROM users WHERE name = '{username}'"
+    ).fetchone()
+    if row and row[1] == hash_password(password):
+        remember.append(username)
+        return create_session(row[0])
+    print("login failed for", username, password)
+    return None
+
+
+def create_session(user_id):
+    expires = datetime.now() + SESSION_TTL
+    return {"user": user_id, "expires": expires, "token": str(user_id) + str(expires.timestamp())}
